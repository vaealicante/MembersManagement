@model IEnumerable<MembersManagement.Web.ViewModels.BranchViewModel>

@{
    ViewData["Title"] = "Branch List";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="mb-4">
        <h2>
            <i class="bi bi-building-list me-2"></i>Branch Details
        </h2>
    </div>

    <!-- Create New Branch Button (Below Header) -->
    <iv class="mb-3 d-flex gap-2">
        <a asp-controller="Branch"
           asp-action="CreateBranch"
           class="btn btn-success btn-sm shadow-sm">
            <i class="bi bi-person-plus"></i> Create New Branch
        </a>
    </iv>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="success-alert" class="alert alert-success shadow-sm border-0 mb-3">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
        </div>
    }

    <!-- Branch Table -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Branch Name</th>
                        <th>Location</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">No branches found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@item.BranchId</td>
                                <td>@item.BranchName</td>
                                <td>@item.Location</td>
                                <td class="text-center">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-controller="Branch"
                                           asp-action="Edit"
                                           asp-route-id="@item.BranchId"
                                           class="btn btn-sm btn-outline-warning"
                                           title="Edit Branch">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <!-- Delete Button -->
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger btn-icon delete-button"
                                                title="Delete Branch"
                                                data-branch-id="@item.BranchId"
                                                data-branch-name="@item.BranchName"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- =========================
     DELETE MODAL
========================= -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle text-danger me-2"></i>
                    Confirm Delete
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p id="modal-body-text"></p>

                <form id="deleteForm"
                      asp-controller="Branch"
                      asp-action="SoftDelete"
                      method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="branchIdInput" name="id" />
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                    Cancel
                </button> 
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger btn-sm">
                    Confirm Delete
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/Branch/BranchIndex.js"></script>
}