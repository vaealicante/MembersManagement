@model IEnumerable<MembersManagement.Web.ViewModels.BranchViewModel>

@{
    ViewData["Title"] = "Branch List";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="mb-4">
        <h2>
            <i class="bi bi-building-list me-2"></i>Branch Details
        </h2>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
            <div id="success-alert" class="alert-container">
                <div class="alert alert-success shadow-sm border-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        <div>@TempData["SuccessMessage"]</div>
                    </div>
                </div>
            </div>

        <script>
            setTimeout(() => {
                const alert = document.getElementById('successAlert');
                if (alert) bootstrap.Alert.getOrCreateInstance(alert).close();
            }, 5000);
        </script>
    }

        <!-- Add New Branch Button -->
        <div class="mb-3 d-flex gap-2">
            <a asp-controller="Branch"
               asp-action="CreateBranch"
               class="btn btn-success btn-sm shadow-sm">
                <i class="bi bi-person-plus"></i>
                Create New Branch
            </a>
        </div>
    </div>

    <!-- Table -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Branch Name</th>
                        <th>Location</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                No branches found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@item.BranchId</td>
                                <td>@item.BranchName</td>
                                <td>@item.Location</td>

                                <td class="text-center">
                                    <div class="d-inline-flex gap-1">

                                        <a asp-controller="Branch"
                                           asp-action="Edit"
                                           asp-route-id="@item.BranchId"
                                           class="btn btn-sm btn-outline-warning btn-icon"
                                           title="Edit Branch">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger btn-icon"
                                                title="Delete Branch"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal-@item.BranchId">
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </div>
                                

                                    <!-- Delete Modal -->
                                    <div class="modal fade"
                                         id="deleteModal-@item.BranchId"
                                         tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">

                                                <div class="modal-header">
                                                    <h5 class="modal-title">
                                                        <i class="bi bi-exclamation-triangle text-danger me-2"></i>
                                                        Confirm Delete
                                                    </h5>
                                                    <button type="button"
                                                            class="btn-close"
                                                            data-bs-dismiss="modal"></button>
                                                </div>

                                                <div class="modal-body">
                                                    Are you sure you want to delete
                                                    <strong>@item.BranchName</strong>?
                                                    <br />
                                                    <small class="text-muted">
                                                        This will deactivate the branch.
                                                    </small>
                                                </div>

                                                <div class="modal-footer">
                                                    <button type="button"
                                                            class="btn btn-outline-secondary btn-sm"
                                                            data-bs-dismiss="modal"
                                                            title="Cancel">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>

                                                    <form asp-controller="Branch"
                                                          asp-action="Delete"
                                                          method="post"
                                                          class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.BranchId" />

                                                        <button type="submit"
                                                                class="btn btn-danger btn-sm"
                                                                title="Confirm Delete">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                    <!-- End Modal -->
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>