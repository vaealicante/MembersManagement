@model IEnumerable<MembersManagement.Web.ViewModels.MembershipViewModel>

@{
    ViewData["Title"] = "Memberships";
}

<h1 class="mb-4">Memberships</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<a href="@Url.Action("Create")" class="btn btn-success mb-3">
    <i class="bi bi-person-plus"></i> Create New Membership
</a>

<div class="card shadow-sm border-0">
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Membership Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        No memberships found.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.MembershipId</td>
                        <td>@m.MembershipName</td>
                        <td>
                            <a href="@Url.Action("Edit", new { id = m.MembershipId })" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <form asp-action="Delete" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@m.MembershipId" />
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?');">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
