@model IEnumerable<MembersManagement.Web.ViewModels.MembershipViewModel>

@{
    ViewData["Title"] = "Memberships";
}

<h1 class="mb-4">Memberships</h1>

<!-- Top-center success message -->
@if (TempData["SuccessMessage"] != null)
{
    <div id="successAlert" class="alert alert-success position-fixed top-0 start-50 translate-middle-x mt-3 z-index-1050">
        @TempData["SuccessMessage"]
    </div>
}

<!-- Create New Membership Button -->
<div class="mb-3 d-flex gap-2">
    <a href="@Url.Action("Create")" class="btn btn-success btn-sm shadow-sm">
        <i class="bi bi-person-plus"></i> Create New Membership
    </a>
</div>

<div class="card shadow-sm border-0">
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Membership Name</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        No memberships found.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.MembershipId</td>
                        <td>@m.MembershipName</td>
                        <td class="text-center">
                            <!-- Edit Icon Button -->
                            <a href="@Url.Action("Edit", new { id = m.MembershipId })"
                               class="btn btn-sm btn-outline-warning btn-icon"
                               title="Edit Membership">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <!-- Delete Icon Button -->
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger btn-icon"
                                    data-id="@m.MembershipId"
                                    data-name="@m.MembershipName"
                                    title="Delete Membership">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="deleteForm" method="post" asp-action="Delete">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong id="membershipName"></strong>? This action cannot be undone.</p>
                    <input type="hidden" name="id" id="membershipId" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Membership/Index.js"></script>
}