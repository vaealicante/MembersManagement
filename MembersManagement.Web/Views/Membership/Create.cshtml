@model MembersManagement.Web.ViewModels.MembershipViewModel

@{
    ViewData["Title"] = "Create Membership";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-star me-1"></i>Create New Membership</h5>
                </div>

                <form asp-action="Create" method="post" class="p-4">
                    @Html.AntiForgeryToken()

                    <!-- Membership Name -->
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted">Membership Name</label>
                        <input asp-for="MembershipName" class="form-control" />
                        <span asp-validation-for="MembershipName" class="text-danger"></span>
                    </div>

                    <hr class="my-4 text-muted">

                    <!-- Buttons -->
                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-success px-4 shadow-sm">
                            <i class="bi bi-save me-2"></i>Save Membership
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}