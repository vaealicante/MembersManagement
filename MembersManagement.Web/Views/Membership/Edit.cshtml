@model MembersManagement.Web.ViewModels.MembershipViewModel

@{
    ViewData["Title"] = "Edit Membership";
}

<h2>Edit Membership</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="MembershipId" />

    <div class="mb-3">
        <label asp-for="MembershipName" class="form-label"></label>
        <input asp-for="MembershipName" class="form-control" />
        <span asp-validation-for="MembershipName" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">Active</label>
    </div>

    <button type="submit" class="btn btn-warning">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}