@model MembersManagement.Web.ViewModels.MembershipViewModel

@{
    ViewData["Title"] = "Edit Membership";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-pencil-square me-2"></i>Edit Membership
                    </h5>
                </div>

                <form asp-action="Edit" method="post" class="p-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MembershipId" />

                    <!-- Membership Name -->
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted">Membership Name</label>
                        <input asp-for="MembershipName" class="form-control border-start-0" />
                        <span asp-validation-for="MembershipName" class="text-danger"></span>
                    </div>

                    <!-- Active Toggle -->
                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Membership Status (Active)</label>
                    </div>

                    <hr class="my-4 text-muted">

                    <!-- Buttons -->
                    <div class="d-flex gap-3">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-warning px-4 shadow-sm fw-bold">
                            <i class="bi bi-check2-circle me-2"></i> Update Membership
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}